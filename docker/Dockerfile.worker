FROM python:3.12.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system --gid 10001 semyzbay \
    && useradd --system --uid 10001 --gid semyzbay --home-dir /app semyzbay

# LibreOffice Writer (headless) converts legacy Word 97-2003 .doc uploads to DOCX before
# parsing. Only the worker parses documents, so the API image stays small.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libreoffice-writer-nogui fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.lock ./
RUN pip install --requirement requirements.lock
COPY app ./app
RUN mkdir -p /app/.cache/fastembed \
    && chown -R semyzbay:semyzbay /app
USER semyzbay
CMD ["celery", "-A", "app.workers.celery_app:celery_app", "worker", "--loglevel=INFO"]
