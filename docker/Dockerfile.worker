FROM python:3.12.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system --gid 10001 semyzbay \
    && useradd --system --uid 10001 --gid semyzbay --home-dir /app semyzbay

WORKDIR /app
COPY requirements.lock ./
RUN pip install --requirement requirements.lock
COPY app ./app
RUN mkdir -p /app/.cache/fastembed \
    && chown -R semyzbay:semyzbay /app
USER semyzbay
CMD ["celery", "-A", "app.workers.celery_app:celery_app", "worker", "--loglevel=INFO"]
