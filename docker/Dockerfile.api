FROM python:3.12.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system --gid 10001 semyzbay \
    && useradd --system --uid 10001 --gid semyzbay --home-dir /app semyzbay

WORKDIR /app
COPY requirements.lock ./
RUN pip install --requirement requirements.lock

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts
RUN chown -R semyzbay:semyzbay /app

USER semyzbay
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
