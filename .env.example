APP_NAME=Semyzbay
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
API_PORT=8000
CELERY_WORKER_CONCURRENCY=1
CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_DB=semyzbay_db
POSTGRES_USER=semyzbay
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://semyzbay:change_me@semyzbay-postgres:5432/semyzbay_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://semyzbay-redis:6379/0
QDRANT_URL=http://semyzbay-qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=semyzbay_documents_v2

MINIO_ENDPOINT=semyzbay-minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=semyzbay-documents
MINIO_AUDIO_BUCKET=semyzbay-audio
MINIO_GENERATED_BUCKET=semyzbay-generated
MINIO_VIDEOS_BUCKET=semyzbay-videos

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-6.1-sol
LLM_MAX_OUTPUT_TOKENS=1200
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
FASTEMBED_CACHE_PATH=.cache/fastembed
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
RERANKER_PROVIDER=embedding
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RAG_RETRIEVAL_LIMIT=30
RAG_RERANK_LIMIT=8
RAG_MIN_RELEVANCE_SCORE=0.05
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_CONTEXT_CHUNKS=8
RAG_SEED_LIMIT=4
RAG_NEIGHBOR_WINDOW=1
RAG_ALLOW_SUSPICIOUS_CONTEXT=false
RAG_TRANSLATE_KAZAKH_QUERIES=true
# Follow-up questions: how many previous messages are used to resolve "а если на высоте?"
CHAT_HISTORY_MESSAGES=6
CHAT_HISTORY_MESSAGE_CHARS=600
CHAT_QUERY_REWRITE=true
CHAT_REWRITE_MAX_OUTPUT_TOKENS=200
STT_PROVIDER=elevenlabs
STT_FALLBACK_PROVIDER=openai
STT_MODEL=gpt-transcribe
TTS_PROVIDER=elevenlabs
TTS_FALLBACK_PROVIDER=openai_realtime
TTS_MODEL=gpt-realtime-2.1-mini
TTS_VOICE=marin
TTS_SPEED=1.0
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
DEFAULT_LANGUAGE=ru

# Optional non-interactive development seed. Never use example passwords in production.
SEED_ORGANIZATION_NAME="Semyzbay Demo"
SEED_ORGANIZATION_DESCRIPTION="Local development organization"
SEED_SUPER_ADMIN_EMAIL=superadmin@semyzbay.kz
SEED_SUPER_ADMIN_PASSWORD=
SEED_ORG_ADMIN_EMAIL=orgadmin@semyzbay.kz
SEED_ORG_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@semyzbay.kz
SEED_USER_PASSWORD=
SEED_SAFETY_EMPLOYEE_PASSWORD=

MAX_UPLOAD_SIZE_BYTES=52428800
MAX_AUDIO_UPLOAD_SIZE_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=300
# Training videos shown next to answers (see docs/frontend-api-guide.md, "Видео")
MAX_VIDEO_UPLOAD_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=1800
# Minimum cosine similarity between the question and a video card; tune with real questions
VIDEO_MATCH_MIN_SCORE=0.55
VIDEO_MAX_SUGGESTIONS=1
VIDEO_URL_TTL_MINUTES=60
PROVIDER_TIMEOUT_SECONDS=30
STORAGE_RETENTION_DAYS=365
HEALTHCHECK_TIMEOUT_SECONDS=3

CELERY_BROKER_URL=redis://semyzbay-redis:6379/1
CELERY_RESULT_BACKEND=redis://semyzbay-redis:6379/2
