APP_NAME=Semyzbay
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_DB=semyzbay_db
POSTGRES_USER=semyzbay
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://semyzbay:change_me@semyzbay-postgres:5432/semyzbay_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://semyzbay-redis:6379/0
QDRANT_URL=http://semyzbay-qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=semyzbay_documents

MINIO_ENDPOINT=semyzbay-minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=semyzbay-documents
MINIO_AUDIO_BUCKET=semyzbay-audio
MINIO_GENERATED_BUCKET=semyzbay-generated

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-6.1-sol
LLM_MAX_OUTPUT_TOKENS=1200
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
RERANKER_PROVIDER=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RAG_RETRIEVAL_LIMIT=30
RAG_RERANK_LIMIT=8
RAG_MIN_RELEVANCE_SCORE=0.05
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_CONTEXT_CHUNKS=8
RAG_ALLOW_SUSPICIOUS_CONTEXT=false
STT_PROVIDER=faster_whisper
WHISPER_MODEL=large-v3
TTS_PROVIDER=openai
TTS_MODEL=configure_model
DEFAULT_LANGUAGE=ru

MAX_UPLOAD_SIZE_BYTES=52428800
MAX_AUDIO_DURATION_SECONDS=300
PROVIDER_TIMEOUT_SECONDS=30
STORAGE_RETENTION_DAYS=365
HEALTHCHECK_TIMEOUT_SECONDS=3

CELERY_BROKER_URL=redis://semyzbay-redis:6379/1
CELERY_RESULT_BACKEND=redis://semyzbay-redis:6379/2
